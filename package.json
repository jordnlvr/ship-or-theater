{
  "name": "ship-or-theater",
  "version": "1.0.1",
  "description": "Paste in an AI claim you saw online and get a straight answer, with evidence: real (SHIPS), half-true (MIXED) or hype (THEATER).",
  "type": "module",
  "license": "MIT",
  "author": "Kelly Seale",
  "keywords": [
    "ai",
    "evaluation",
    "rubric",
    "scorecard",
    "anthropic",
    "claude",
    "mcp",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordnlvr/ship-or-theater.git"
  },
  "homepage": "https://github.com/jordnlvr/ship-or-theater#readme",
  "bugs": {
    "url": "https://github.com/jordnlvr/ship-or-theater/issues"
  },
  "bin": {
    "ship-or-theater": "dist/cli.js",
    "ship-or-theater-mcp": "dist/mcp.js"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "dev": "tsup --watch",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.10.0",
    "commander": "^13.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
